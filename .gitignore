__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.DS_Store

# Large data - never commit, README documents expected layout
/data/**
!/data/README.md

# Trained weights are large - document where to get/regenerate them, don't commit by default
checkpoints/*.pt
checkpoints/*.pth
!checkpoints/.gitkeep

# Generated outputs
outputs/*
!outputs/.gitkeep

# Note: figures under reports/figures/ are NOT ignored - every one generated
# so far (Phase 1 analysis, insurance checks, training curves, PPT visuals)
# has been a real deliverable referenced in the README/reports, not scratch.
# An earlier blanket "reports/figures/*.png" rule here silently excluded all
# of them from every commit until this was caught - if a genuinely disposable
# debug image needs excluding in the future, ignore it by exact filename,
# not by a blanket pattern that swallows real deliverables unnoticed.

# Chunked-upload scratch artifacts (Kaggle dataset/code upload workflow) -
# never commit, the actual uploads already landed on Kaggle/GitHub
/_data_chunks/
/_to_delete_data_chunks/
/_split.log
/*.zip

# Scratch working files from scripts/scale_generalization_test.py (raw
# .npy inputs/outputs) - the deliverable is the summary CSV it also
# writes to reports/, not these intermediates
reports/_scale_gen_test_tmp/

# scripts/quick_test_visualize.py output - ad-hoc personal confidence-checks
# and PPT example-pulling, not project deliverables. Narrowly scoped by
# exact filename prefix (not a blanket reports/figures/*.png rule - see the
# comment above re: the prior incident where a blanket rule swallowed real
# deliverables). Working temp dir also excluded.
reports/figures/quick_test_*.png
reports/figures/_quick_test_tmp/
